# =============================================================================
# CHFR LDN — environment configuration
#
# Copy to .env for local development. In production, set these as environment
# variables on the host (Render dashboard) — never commit real values.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL. Used in email links, WhatsApp links and CSP. No trailing slash.
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Set to true behind a reverse proxy / load balancer (Render sets this for you
# in production automatically; only needed if you proxy in development).
TRUST_PROXY=false

# --- Database (required in production) --------------------------------------
DATABASE_URL=postgresql://chfr:chfr@localhost:5432/chfr
# Render's managed Postgres requires SSL.
DATABASE_SSL=false
# 'pg' for a real PostgreSQL server. 'pglite' spins up a throwaway in-memory
# Postgres — used by the test-suite; never use it in production.
DB_DRIVER=pg

# --- Security (required in production) --------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Staff sessions expire after this many hours.
SESSION_TTL_HOURS=12
# Salt for the one-way IP hash used in abuse detection. Raw IPs are never stored.
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# --- Email ------------------------------------------------------------------
# Where new booking alerts are sent.
ADMIN_EMAIL=CHFRLONDON@GMAIL.COM
EMAIL_ENABLED=true
# Gmail: smtp.gmail.com / 587. Requires an App Password (see README).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Must be an address the SMTP account is allowed to send as.
SMTP_FROM=CHFR LDN <bookings@chfrldn.com>

# --- WhatsApp (optional, via self-hosted OpenWA) -----------------------------
# Leave false until OpenWA is running and paired. Bookings work fine without it.
WHATSAPP_ENABLED=false
# Private URL of the OpenWA container. Do NOT expose OpenWA to the public internet.
OPENWA_BASE_URL=http://openwa:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=CHFR
OPENWA_TIMEOUT_MS=15000
# CHFR business number in E.164 format, e.g. +447700900000
CHFR_WHATSAPP_NUMBER=

# --- Spreadsheet (optional) --------------------------------------------------
# 'none'   — no live sheet; CSV/XLSX export from the dashboard is still available.
# 'google' — live Google Sheet, one row per booking, kept in sync.
SPREADSHEET_PROVIDER=none
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Bookings
# The service account's JSON key. Either raw JSON on one line, or base64-encoded
# (easier to paste into a Render environment variable):
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Anti-spam ---------------------------------------------------------------
# Cloudflare Turnstile. Optional — the honeypot and rate limiting work without it.
# Both keys must be set for the widget to appear.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Booking submissions allowed per IP per window.
BOOKING_RATE_LIMIT_MAX=6
BOOKING_RATE_LIMIT_WINDOW_MIN=60
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# --- Business ----------------------------------------------------------------
DEFAULT_CURRENCY=GBP
BUSINESS_TIMEZONE=Europe/London
# Master switch for customer-facing update emails. Staff still have to tick the
# box per change; this turns the feature off entirely.
CUSTOMER_UPDATE_EMAILS_ENABLED=true

# --- First admin account (used only by `npm run create-admin`) ---------------
# Optional: set these to create the first account non-interactively on deploy.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=ADMIN
